# Copy to .env and fill in at least one provider. Everything else is optional.

# --- Providers -------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible server (vLLM, Ollama, LM Studio, ...).
OPENAI_BASE_URL=

# Google Gemini (key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AWS Bedrock. Leave the keys empty to use the default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Gateway ---------------------------------------------------------------

# Model used when a request does not pick one: openai, gemini or bedrock.
# Empty means the first provider that has credentials.
DEFAULT_MODEL=

# Shared secret between the agents and the gateway. Empty disables auth.
GATEWAY_API_KEY=

CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- Agents ----------------------------------------------------------------

MAX_TOOL_ROUNDS=6
LOG_LEVEL=INFO

# --- Tracing (optional) ----------------------------------------------------

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=toolbox-gateway
